{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "cadence-editor",
  "version": "0.1.0",
  "identifier": "com.cadence.editor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Cadence",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/**", "/tmp/**", "/private/tmp/**", "/var/folders/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/cadence",
      "binaries/ellua"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
