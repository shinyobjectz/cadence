{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "allow-open-project",
    "allow-save-studio",
    "allow-pick-folder",
    "allow-pick-file",
    "allow-import-file",
    "allow-import-comp",
    "allow-read-project-file",
    "allow-read-ellua-lib",
    "allow-read-ellua-eval",
    "allow-resolve-ellua-asset",
    "allow-resolve-cadence-path",
    "allow-resolve-project-asset",
    "allow-open-editor-doc",
    "allow-ensure-editor-vo-cmd",
    "allow-read-editor-doc",
    "allow-save-editor-doc",
    "allow-write-comp-inputs",
    "allow-save-asset-bytes",
    "allow-set-secret",
    "allow-secret-is-set",
    "allow-generate-text",
    "allow-generate-image",
    "allow-generate-video",
    "allow-start-render",
    "allow-start-check",
    "allow-start-capture",
    "allow-list-capture-outputs",
    "allow-start-tts",
    "allow-generate-local-vo-cmd",
